module tb_seq_110_or_1011_detector();

       reg clk;
    reg rst;
    reg in;

    // Output
    wire z;

    // Instantiate DUT
    seq_110_or_1011_detector dut (
        .clk(clk),
        .rst(rst),
        .in(in),
        .z(z)
    );

    // Clock generation: 10ns period
    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    // Apply stimulus manually (bitstream = 110110010110)
    initial begin
        // VCD dump
        $dumpfile("seq_detect.vcd");
        $dumpvars(0, tb_seq_110_or_1011_detector);

        // Initialize
        rst = 1; in = 0;
        #12;
        rst = 0;

        // Apply bits at each falling clock edge
        @(posedge clk); in = 1;   // bit 11
        @(posedge clk); in = 1;   // bit 10
        @(posedge clk); in = 0;   // bit 9
        @(posedge clk); in = 1;   // bit 8
        @(posedge clk); in = 1;   // bit 7
        @(posedge clk); in = 0;   // bit 6
        @(posedge clk); in = 0;   // bit 5
        @(posedge clk); in = 1;   // bit 4
        @(posedge clk); in = 0;   // bit 3
        @(posedge clk); in = 1;   // bit 2
        @(posedge clk); in = 1;   // bit 1
        @(posedge clk); in = 0;   // bit 0

        // Hold for a few more cycles
        repeat (5) @(posedge clk);
        $finish;
    end

    // Optional Monitor
    initial begin
        $display("Time\tclk\tin\tz");
        $monitor("%4t\t%b\t%b\t%b", $time, clk, in, z);
    end


endmodule

