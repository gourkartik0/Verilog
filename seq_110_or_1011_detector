module seq_110_or_1011_detector(
    input clk,
    input rst,
    input in,
    output reg z
    );
    localparam S0 = 3'd0;
    localparam S1 = 3'd1;
    localparam S2 = 3'd2;
    localparam S3 = 3'd3;
    localparam S4 = 3'd4;

    reg [2:0] current_state, next_state;
    
    always@(posedge clk or posedge rst)begin
    if(rst)
        current_state<=S0;
     else
        current_state<=next_state;
    end
    
    ///////NEXT STATE AND OUTPUT LOGIC
    
    always@(*)begin
        next_state=current_state;
        z=0;   
        
        case(current_state)
        S0:begin
        if(in) next_state=S1;  // got 1
        else   next_state=S0;     
        end
        S1:begin
            if(in) next_state=S2;  //got 11
            else next_state=S3;    //got 10
        end
        
        S2:begin
        if(!in)begin next_state=S3;  // got 110
                z=1;
        end
        else next_state=S2;          // got 111 and 11 will we reused
        end
        S3:begin
            if(in)next_state=S4; // got 101
            else next_state=S0;  // got 100
        end
        S4:begin
        if(in)begin next_state=S2;    // got 1011  and 11 will be reused
            z=1;        
        end
        else
            next_state=S3;             // got 1010 and 10 will be reused
        end
        default: next_state=S0;
        endcase
    end
    
endmodule


